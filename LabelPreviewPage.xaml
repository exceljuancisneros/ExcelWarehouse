<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:sf="clr-namespace:Syncfusion.Maui.Buttons;assembly=Syncfusion.Maui.Buttons"
             x:Class="PrintLabels.LabelPreviewPage"
             BackgroundColor="#ffffff">

    <ScrollView>
        <VerticalStackLayout Padding="8" Spacing="8">

            <!-- Label Preview Card (white background, black borders) -->
            <Border Background="#ffffff" Stroke="#000000" StrokeShape="RoundRectangle 0" StrokeThickness="2">
                <VerticalStackLayout Spacing="4" Padding="10">

                    <!-- Top Row: Su-Sa (7 columns horizontal) -->
                    <Grid ColumnDefinitions="*,*,*,*,*,*,*" RowDefinitions="Auto,Auto">
                        <!-- Day labels -->
                        <Label Grid.Row="0" Grid.Column="0" Text="Su" FontSize="14" TextColor="#000000" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center"/>
                        <Label Grid.Row="0" Grid.Column="1" Text="Mo" FontSize="14" TextColor="#000000" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center"/>
                        <Label Grid.Row="0" Grid.Column="2" Text="Tu" FontSize="14" TextColor="#000000" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center"/>
                        <Label Grid.Row="0" Grid.Column="3" Text="We" FontSize="14" TextColor="#000000" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center"/>
                        <Label Grid.Row="0" Grid.Column="4" Text="Th" FontSize="14" TextColor="#000000" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center"/>
                        <Label Grid.Row="0" Grid.Column="5" Text="Fr" FontSize="14" TextColor="#000000" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center"/>
                        <Label Grid.Row="0" Grid.Column="6" Text="Sa" FontSize="14" TextColor="#000000" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center"/>
                        
                        <!-- Values -->
                        <Label Grid.Row="1" Grid.Column="0" x:Name="lblVer1" Text="000" FontSize="20" TextColor="#000000" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center"/>
                        <Label Grid.Row="1" Grid.Column="1" x:Name="lblVer2" Text="000" FontSize="20" TextColor="#000000" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center"/>
                        <Label Grid.Row="1" Grid.Column="2" x:Name="lblVer3" Text="000" FontSize="20" TextColor="#000000" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center"/>
                        <Label Grid.Row="1" Grid.Column="3" x:Name="lblVer4" Text="000" FontSize="20" TextColor="#000000" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center"/>
                        <Label Grid.Row="1" Grid.Column="4" x:Name="lblVer5" Text="000" FontSize="20" TextColor="#000000" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center"/>
                        <Label Grid.Row="1" Grid.Column="5" x:Name="lblVer6" Text="000" FontSize="20" TextColor="#000000" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center"/>
                        <Label Grid.Row="1" Grid.Column="6" x:Name="lblVer7" Text="000" FontSize="20" TextColor="#000000" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center"/>
                    </Grid>
                    
                    <!-- Divider line -->
                    <BoxView HeightRequest="1" Color="#000000" Margin="0,4,0,4"/>

                    <!-- Middle Row: Location + Arrow (horizontal) -->
                    <Grid ColumnDefinitions="*,*,*,*,*" RowDefinitions="Auto,Auto">
                        <!-- Labels -->
                        <Label Grid.Row="0" Grid.Column="0" Text="WAREHOUSE" FontSize="12" TextColor="#000000" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center"/>
                        <Label Grid.Row="0" Grid.Column="1" Text="AISLE" FontSize="12" TextColor="#000000" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center"/>
                        <Label Grid.Row="0" Grid.Column="2" Text="COLUMN" FontSize="12" TextColor="#000000" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center"/>
                        <Label Grid.Row="0" Grid.Column="3" Text="LEVEL" FontSize="12" TextColor="#000000" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center"/>
                        <Label Grid.Row="0" Grid.Column="4" Text="SPOT" FontSize="12" TextColor="#000000" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center"/>
                        
                        <!-- Values -->
                        <Label Grid.Row="1" Grid.Column="0" x:Name="lblWarehouse" Text="0" FontSize="20" TextColor="#000000" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center"/>
                        <Label Grid.Row="1" Grid.Column="1" x:Name="lblAisle" Text="0" FontSize="20" TextColor="#000000" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center"/>
                        <Label Grid.Row="1" Grid.Column="2" x:Name="lblColumn" Text="0" FontSize="20" TextColor="#000000" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center"/>
                        <Label Grid.Row="1" Grid.Column="3" x:Name="lblLevel" Text="0" FontSize="20" TextColor="#000000" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center"/>
                        <Label Grid.Row="1" Grid.Column="4" x:Name="lblSpot" Text="0" FontSize="20" TextColor="#000000" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center"/>
                    </Grid>
                    
                    <!-- Divider line -->
                    <BoxView HeightRequest="1" Color="#000000" Margin="0,4,0,4"/>

                    <!-- Bottom Row: QR Code + ItemNumber + ItemCodeDesc -->
                    <HorizontalStackLayout Spacing="15" HorizontalOptions="Fill">
                        <Image x:Name="qrCodeImage" HeightRequest="80" WidthRequest="80" HorizontalOptions="Start"/>
                        <VerticalStackLayout Spacing="2" HorizontalOptions="Fill">
                            <Label x:Name="lblItemNumber" Text="000000" FontSize="18" TextColor="#000000" FontAttributes="Bold"/>
                            <Label x:Name="lblItemCodeDesc" Text="ITEM DESCRIPTION" FontSize="14" TextColor="#000000" FontAttributes="Bold" LineBreakMode="WordWrap"/>
                        </VerticalStackLayout>
                    </HorizontalStackLayout>
                    
                    <!-- Divider line -->
                    <BoxView HeightRequest="1" Color="#000000" Margin="0,4,0,4"/>

                    <!-- Footer: Comment -->
                    <Label x:Name="lblComment" Text="??????" FontSize="16" TextColor="#000000" FontAttributes="Bold" HorizontalOptions="Center"/>

                </VerticalStackLayout>
            </Border>

            <!-- Action Buttons Section -->
            <VerticalStackLayout Spacing="8" Padding="10">
                
                <!-- Row 1: Quantity Controls (- / +) -->
                <HorizontalStackLayout HorizontalOptions="Center" Spacing="8">
                    <sf:SfButton x:Name="MinusButton" Text="&#xf068;"
                                 FontFamily="FontAwesome"
                                 FontSize="18"
                                 TextColor="#ffffff"
                                 Background="#ef4444"
                                 WidthRequest="40" HeightRequest="40"
                                 HorizontalTextAlignment="Center"
                                 VerticalTextAlignment="Center"
                                 Clicked="OnQuantityMinusClicked"/>
                    <Label x:Name="QuantityLabel" Text="1" FontSize="20" TextColor="#333333" FontAttributes="Bold" VerticalOptions="Center"/>
                    <sf:SfButton x:Name="PlusButton" Text="&#xf067;"
                                 FontFamily="FontAwesome"
                                 FontSize="18"
                                 TextColor="#ffffff"
                                 Background="#22c55e"
                                 WidthRequest="40" HeightRequest="40"
                                 HorizontalTextAlignment="Center"
                                 VerticalTextAlignment="Center"
                                 Clicked="OnQuantityPlusClicked"/>
                </HorizontalStackLayout>

                <!-- Row 2: Print & IPPrint -->
                <HorizontalStackLayout HorizontalOptions="Center" Spacing="8">
                    <sf:SfButton x:Name="PrintButton" Text="&#xf02f; PRINT"
                                 FontFamily="FontAwesome"
                                 FontSize="16"
                                 TextColor="#ffffff"
                                 Background="#059669"
                                 WidthRequest="110" HeightRequest="45"
                                 HorizontalTextAlignment="Center"
                                 VerticalTextAlignment="Center"
                                 Clicked="OnPrintNowClicked"/>
                    <sf:SfButton x:Name="IPrintButton" Text="&#xf02f; IPPRINT"
                                 FontFamily="FontAwesome"
                                 FontSize="16"
                                 TextColor="#000000"
                                 Background="#f59e0b"
                                 WidthRequest="130" HeightRequest="45"
                                 HorizontalTextAlignment="Center"
                                 VerticalTextAlignment="Center"
                                 Clicked="OnIPrintNowClicked"/>
                </HorizontalStackLayout>

                <!-- Row 3: Print Another -->
                <sf:SfButton Text="PRINT ANOTHER"
                             FontSize="16"
                             TextColor="#ffffff"
                             Background="#2563eb"
                             WidthRequest="200" HeightRequest="45"
                             HorizontalOptions="Center"
                             HorizontalTextAlignment="Center"
                             VerticalTextAlignment="Center"
                             Clicked="OnPrintAnotherClicked"/>

            </VerticalStackLayout>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>