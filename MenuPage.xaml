<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:sf="clr-namespace:Syncfusion.Maui.Buttons;assembly=Syncfusion.Maui.Buttons"
             x:Class="PrintLabels.MenuPage"
             BackgroundColor="#0d1117"
             NavigationPage.HasNavigationBar="false">

    <Grid RowDefinitions="Auto,*">
        <!-- Header Row -->
        <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" Padding="16,12,16,0">
            <!-- Left spacer to balance title centering -->
            <BoxView Grid.Column="0" WidthRequest="36" HeightRequest="36" 
                     Background="Transparent" VerticalOptions="Center"/>
            
            <!-- Title (centered) -->
            <Label Grid.Column="1"
                   Text="Excel Warehouse"
                   FontSize="20"
                   FontAttributes="Bold"
                   TextColor="#f0f6fc"
                   VerticalOptions="Center"
                   HorizontalOptions="Center"/>
            
            <!-- Logout Button (top-right) -->
            <Button Grid.Column="2"
                    Text="🚪"
                    FontSize="22"
                    TextColor="#dc2626"
                    BackgroundColor="Transparent"
                    Clicked="OnLogoutClicked"/>
        </Grid>

        <!-- Body Content -->
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="24" Spacing="16" Margin="0,20,0,0">

            <!-- Title -->
            <Border HorizontalOptions="Center" WidthRequest="70" HeightRequest="70"
                    Stroke="#30363d" StrokeShape="RoundRectangle 16"
                    Background="#161b22" Margin="0,0,0,8">
                <Label Text="&#xf494;" FontFamily="FontAwesome" FontSize="36"
                       TextColor="#58a6ff" HorizontalOptions="Center" VerticalOptions="Center"/>
            </Border>

            <Label Text="Excel Warehouse"
                   FontSize="28" FontAttributes="Bold" TextColor="#f0f6fc"
                   HorizontalOptions="Center"/>

            <Label Text="Select an option below"
                   FontSize="15" TextColor="#8b949e"
                   HorizontalOptions="Center" Margin="0,4,0,16"/>

            <!-- Divider -->
            <BoxView HeightRequest="1" Color="#30363d" Margin="0,0,0,16"/>

            <!-- Print Labels Button -->
            <Border Stroke="#30363d" StrokeShape="RoundRectangle 12" Background="#161b22">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnPrintLabelsTapped"/>
                </Border.GestureRecognizers>
                <HorizontalStackLayout Spacing="16" VerticalOptions="Center" Padding="16,0">
                    <!-- Icon -->
                    <Border Background="#1f6feb" WidthRequest="50" HeightRequest="50" StrokeShape="RoundRectangle 12">
                        <Label Text="&#xf02c;" FontFamily="FontAwesome" FontSize="24"
                               TextColor="#ffffff" HorizontalOptions="Center" VerticalOptions="Center"/>
                    </Border>

                    <!-- VerticalStackLayout for Text -->
                    <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Start">
                        <Label Text="Print Labels"
                               FontSize="18" FontAttributes="Bold" TextColor="#f0f6fc"/>
                        <Label Text="Scan or type an item to print a label"
                               FontSize="13" TextColor="#8b949e"/>
                    </VerticalStackLayout>
                </HorizontalStackLayout>
            </Border>

            <!-- Coming Soon placeholder for future buttons -->
            <Border Stroke="#30363d" StrokeShape="RoundRectangle 12" Background="#0d1117">
                <HorizontalStackLayout Spacing="16" VerticalOptions="Center" Padding="16,0">
                    <Border Background="#21262d" WidthRequest="50" HeightRequest="50" StrokeShape="RoundRectangle 12">
                        <Label Text="&#xf49b;" FontFamily="FontAwesome" FontSize="24"
                               TextColor="#8b949e" HorizontalOptions="Center" VerticalOptions="Center"/>
                    </Border>

                    <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Start">
                        <Label Text="Coming Soon"
                               FontSize="18" FontAttributes="Bold" TextColor="#8b949e"/>
                        <Label Text="New feature coming soon"
                               FontSize="13" TextColor="#6e7681"/>
                    </VerticalStackLayout>
                </HorizontalStackLayout>
            </Border>

            <!-- Spacer -->
            <BoxView HeightRequest="16" WidthRequest="1"/>

        </VerticalStackLayout>
    </ScrollView>

    </Grid>

</ContentPage>
