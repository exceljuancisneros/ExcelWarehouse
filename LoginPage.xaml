<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:sf="clr-namespace:Syncfusion.Maui.Buttons;assembly=Syncfusion.Maui.Buttons"
             x:Class="PrintLabels.LoginPage"
             BackgroundColor="#f0f2f5">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="20" VerticalOptions="Center">

            <!-- Logo Image -->
            <Image Source="excel_logo.png"
                   HorizontalOptions="Center"
                   HeightRequest="80"
                   Aspect="AspectFit"/>

            <!-- Identity Provider subtitle -->
            <Label Text="Excel Identity Provider"
                   FontSize="13" TextColor="#666666"
                   HorizontalOptions="Center"
                   FontFamily="Arial"/>

            <!-- Login Card -->
            <Border Stroke="#e0e0e0" StrokeShape="RoundRectangle 12"
                    Background="White" Padding="24,20"
                    Shadow="0,2,8,#20000000">
                <VerticalStackLayout Spacing="16">

                    <!-- Title with separator -->
                    <Label Text="Log in"
                           FontSize="22" FontAttributes="Bold" TextColor="#222222"
                           FontFamily="Arial"/>
                    <BoxView HeightRequest="1" Color="#e0e0e0" HorizontalOptions="Fill"/>

                    <!-- Username field -->
                    <VerticalStackLayout Spacing="6">
                        <Label Text="User"
                               FontSize="13" TextColor="#444444"
                               FontFamily="Arial"/>
                        <Border Stroke="#d0d0d0" StrokeShape="RoundRectangle 8"
                                Background="White">
                            <Grid ColumnDefinitions="*,Auto">
                                <Entry x:Name="UsernameEntry"
                                       Placeholder="Username" PlaceholderColor="#aaaaaa"
                                       TextColor="#333333"
                                       Keyboard="Email"
                                       Completed="OnUsernameCompleted"
                                       BackgroundColor="Transparent"
                                       Grid.Column="0" Margin="12,0"/>
                                <!-- User icon in gray section -->
                                <Border Stroke="Transparent" StrokeShape="RoundRectangle 8 0 0 8"
                                        Background="#f0f0f0" Grid.Column="1">
                                    <Label Text="&#xf007;" FontFamily="FontAwesome" FontSize="18" TextColor="#666666" Margin="10,12"/>
                                </Border>
                            </Grid>
                        </Border>
                    </VerticalStackLayout>

                    <!-- Password field -->
                    <VerticalStackLayout Spacing="6">
                        <Label Text="Password"
                               FontSize="13" TextColor="#444444"
                               FontFamily="Arial"/>
                        <Border Stroke="#d0d0d0" StrokeShape="RoundRectangle 8"
                                Background="White">
                            <Grid ColumnDefinitions="*,Auto,Auto">
                                <Entry x:Name="PasswordEntry"
                                       Placeholder="Password" PlaceholderColor="#aaaaaa"
                                       TextColor="#333333"
                                       IsPassword="True"
                                       Completed="OnLoginClicked"
                                       BackgroundColor="Transparent"
                                       Grid.Column="0" Margin="12,0"
                                       TextChanged="OnPasswordTextChanged"/>
                                <!-- Eye icon - transparent, visible when typing, left of lock -->
                                <Label x:Name="EyeIcon"
                                       Text="&#xf06e;" FontFamily="FontAwesome" FontSize="18" TextColor="#666666"
                                       Grid.Column="1" Margin="6,0" HorizontalOptions="Center" VerticalOptions="Center"
                                       IsVisible="False">
                                    <Label.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnEyeIconTapped" />
                                    </Label.GestureRecognizers>
                                </Label>
                                <!-- Lock icon in gray section -->
                                <Border Stroke="Transparent" StrokeShape="RoundRectangle 8 0 0 8"
                                        Background="#f0f0f0" Grid.Column="2">
                                    <Label Text="&#xf023;" FontFamily="FontAwesome" FontSize="18" TextColor="#666666" Margin="10,12"/>
                                </Border>
                            </Grid>
                        </Border>
                    </VerticalStackLayout>

                    <!-- Error message -->
                    <Label x:Name="ErrorLabel"
                           TextColor="#e3000f" FontSize="13"
                           HorizontalOptions="Start"
                           IsVisible="False"
                           FontFamily="Arial"/>

                    <!-- Sign In Button -->
                    <Border Stroke="Transparent" StrokeShape="RoundRectangle 25"
                            Background="#1a2b4c" HorizontalOptions="Fill">
                        <Button x:Name="LoginButton"
                                Text="Sign In"
                                FontSize="17" FontAttributes="Bold"
                                TextColor="White"
                                BackgroundColor="Transparent"
                                BorderColor="Transparent"
                                HeightRequest="50"
                                Clicked="OnLoginClicked"/>
                    </Border>

                </VerticalStackLayout>
            </Border>

            <!-- Support Card -->
            <Border Stroke="#e0e0e0" StrokeShape="RoundRectangle 12"
                    Background="White" Padding="18,16"
                    Shadow="0,2,8,#10000000">
                <VerticalStackLayout Spacing="6">
                    <Label Text="Having trouble logging in?"
                           FontSize="15" FontAttributes="Bold" TextColor="#e3000f"
                           FontFamily="Arial"/>
                    <Label Text="Contact the Excel Grocery administrator to reset your password or unlock your account."
                           FontSize="12" TextColor="#666666"
                           FontFamily="Arial"/>
                </VerticalStackLayout>
            </Border>

            <!-- Version -->
            <Label x:Name="VersionLabel"
                   FontSize="11"
                   TextColor="#999999"
                   HorizontalOptions="Center"
                   VerticalOptions="End"
                   Margin="0,8,0,0"
                   FontFamily="Arial"/>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
