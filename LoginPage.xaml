<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:sf="clr-namespace:Syncfusion.Maui.Buttons;assembly=Syncfusion.Maui.Buttons"
             x:Class="PrintLabels.LoginPage"
             BackgroundColor="#f0f0f0">

    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="24" VerticalOptions="Center">

            <!-- Logo & Branding -->
            <VerticalStackLayout HorizontalOptions="Center" Spacing="2">
                <!-- EXCEL text in red -->
                <Label Text="EXCEL"
                       FontSize="48" FontAttributes="Bold" TextColor="#e3000f"
                       HorizontalOptions="Center" FontFamily="Arial"/>
                <!-- Distribution, LLC in white pill -->
                <Border Stroke="Transparent" StrokeShape="RoundRectangle 12"
                        Background="#e3000f" Padding="16,6" HorizontalOptions="Center">
                    <Label Text="Distribution, LLC"
                           FontSize="16" TextColor="White"
                           HorizontalOptions="Center" FontFamily="Arial"/>
                </Border>
            </VerticalStackLayout>

            <!-- Identity Provider subtitle -->
            <Label Text="Excel Identity Provider"
                   FontSize="13" TextColor="#666666"
                   HorizontalOptions="Center" Margin="0,4,0,8"
                   FontFamily="Arial"/>

            <!-- Login Card -->
            <Border Stroke="#e0e0e0" StrokeShape="RoundRectangle 12"
                    Background="White" Padding="28,24"
                    Shadow="0,2,8,#20000000">
                <VerticalStackLayout Spacing="18">

                    <!-- Title -->
                    <Label Text="Log in"
                           FontSize="22" FontAttributes="Bold" TextColor="#222222"
                           FontFamily="Arial"/>

                    <!-- Username field -->
                    <VerticalStackLayout Spacing="6">
                        <Label Text="User"
                               FontSize="13" TextColor="#444444"
                               FontFamily="Arial"/>
                        <Border Stroke="#d0d0d0" StrokeShape="RoundRectangle 8"
                                Background="#fafafa" Padding="4,0">
                            <HorizontalStackLayout Spacing="10" VerticalOptions="Center" Padding="10,0">
                                <!-- User icon -->
                                <Label Text="&#xf007;" FontFamily="FontAwesome" FontSize="18" TextColor="#999999"/>
                                <Entry x:Name="UsernameEntry"
                                       Placeholder="Username" PlaceholderColor="#aaaaaa"
                                       TextColor="#333333"
                                       Keyboard="Email"
                                       Completed="OnUsernameCompleted"
                                       BackgroundColor="Transparent"/>
                            </HorizontalStackLayout>
                        </Border>
                    </VerticalStackLayout>

                    <!-- Password field -->
                    <VerticalStackLayout Spacing="6">
                        <Label Text="Password"
                               FontSize="13" TextColor="#444444"
                               FontFamily="Arial"/>
                        <Border Stroke="#d0d0d0" StrokeShape="RoundRectangle 8"
                                Background="#fafafa" Padding="4,0">
                            <HorizontalStackLayout Spacing="10" VerticalOptions="Center" Padding="10,0">
                                <!-- Lock icon -->
                                <Label Text="&#xf023;" FontFamily="FontAwesome" FontSize="18" TextColor="#999999"/>
                                <Entry x:Name="PasswordEntry"
                                       Placeholder="Password" PlaceholderColor="#aaaaaa"
                                       TextColor="#333333"
                                       IsPassword="True"
                                       Completed="OnLoginClicked"
                                       BackgroundColor="Transparent"/>
                                <!-- Eye toggle -->
                                <Label x:Name="EyeIcon"
                                       Text="&#xf06e;" FontFamily="FontAwesome" FontSize="18" TextColor="#999999"
                                       HorizontalOptions="End" VerticalOptions="Center">
                                    <Label.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnEyeIconTapped" />
                                    </Label.GestureRecognizers>
                                </Label>
                            </HorizontalStackLayout>
                        </Border>
                    </VerticalStackLayout>

                    <!-- Error message -->
                    <Label x:Name="ErrorLabel"
                           TextColor="#e3000f" FontSize="13"
                           HorizontalOptions="Start"
                           IsVisible="False" Margin="0,4,0,0"
                           FontFamily="Arial"/>

                    <!-- Login Button -->
                    <Border Stroke="Transparent" StrokeShape="RoundRectangle 25"
                            Background="#1a2b4c" HorizontalOptions="Fill">
                        <Button x:Name="LoginButton"
                                Text="Sign In"
                                FontSize="17" FontAttributes="Bold"
                                TextColor="White"
                                BackgroundColor="Transparent"
                                BorderColor="Transparent"
                                HeightRequest="50"
                                Clicked="OnLoginClicked"/>
                    </Border>

                </VerticalStackLayout>
            </Border>

            <!-- Support Card -->
            <Border Stroke="#e0e0e0" StrokeShape="RoundRectangle 12"
                    Background="White" Padding="18,16"
                    Shadow="0,2,8,#10000000">
                <VerticalStackLayout Spacing="6">
                    <Label Text="Having trouble logging in?"
                           FontSize="15" FontAttributes="Bold" TextColor="#e3000f"
                           FontFamily="Arial"/>
                    <Label Text="Contact the Excel Grocery administrator to reset your password or unlock your account."
                           FontSize="12" TextColor="#666666"
                           FontFamily="Arial"/>
                </VerticalStackLayout>
            </Border>

            <!-- Version -->
            <Label x:Name="VersionLabel"
                   FontSize="11"
                   TextColor="#999999"
                   HorizontalOptions="Center"
                   VerticalOptions="End"
                   Margin="0,8,0,0"
                   FontFamily="Arial"/>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
