<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:sf="clr-namespace:Syncfusion.Maui.Buttons;assembly=Syncfusion.Maui.Buttons"
             x:Class="PrintLabels.BluetoothSettingsPage"
             BackgroundColor="#0d1117">

    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="16" VerticalOptions="Center">

            <!-- Title -->
            <Label Text="&#xf085;  Bluetooth Printer"
                   FontFamily="FontAwesome"
                   FontSize="26"
                   FontAttributes="Bold"
                   TextColor="#f0f6fc"
                   HorizontalOptions="Center"/>

            <Label Text="Connect to your printer"
                   FontSize="14"
                   TextColor="#8b949e"
                   HorizontalOptions="Center"
                   Margin="0,0,0,12"/>

            <!-- Divider -->
            <BoxView HeightRequest="1" Color="#30363d" Margin="0,0,0,12"/>

            <!-- Status -->
            <Border Stroke="#30363d" StrokeShape="RoundRectangle 8" Background="#161b22" Padding="12">
                <Label x:Name="StatusLabel"
                       Text="&#xf071;  Tap 'Scan' to find printers"
                       FontFamily="FontAwesome"
                       FontSize="14"
                       TextColor="#8b949e"/>
            </Border>

            <!-- Selected Printer -->
            <Border Stroke="#30363d" StrokeShape="RoundRectangle 8" Background="#161b22" Padding="12">
                <VerticalStackLayout Spacing="6">
                    <Label Text="&#xf058;  Selected Printer"
                           FontFamily="FontAwesome"
                           FontSize="12"
                           TextColor="#8b949e"/>
                    <Label x:Name="SelectedPrinterLabel"
                           Text="None"
                           FontSize="16"
                           TextColor="#f0f6fc"/>
                </VerticalStackLayout>
            </Border>

            <!-- Available Printers List -->
            <Label Text="&#xf0c1;  Available Devices"
                   FontFamily="FontAwesome"
                   FontSize="14"
                   FontAttributes="Bold"
                   TextColor="#58a6ff"
                   Margin="0,8,0,4"/>

            <Border Stroke="#30363d" StrokeShape="RoundRectangle 8" Background="#161b22" Padding="0">
                <CollectionView x:Name="PrinterList"
                                SelectionMode="None">
                    <CollectionView.ItemsLayout>
                        <LinearItemsLayout Orientation="Vertical" ItemSpacing="1"/>
                    </CollectionView.ItemsLayout>
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#0d1117"
                                    Stroke="#30363d"
                                    Padding="12"
                                    Margin="0">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnDeviceItemTapped" NumberOfTapsRequired="1" />
                                </Border.GestureRecognizers>
                                <HorizontalStackLayout Spacing="12">
                                    <Label Text="{Binding Address}"
                                           FontSize="14"
                                           TextColor="#58a6ff"
                                           VerticalOptions="Center"/>
                                    <Label Text="{Binding Name}"
                                           FontSize="15"
                                           TextColor="#c9d1d9"
                                           VerticalOptions="Center"
                                           HorizontalOptions="FillAndExpand"/>
                                    <Label Text="&#xf04c;"
                                           FontFamily="FontAwesome"
                                           FontSize="14"
                                           TextColor="#3fb950"
                                           VerticalOptions="Center"
                                           IsVisible="{Binding IsSelected}"/>
                                </HorizontalStackLayout>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </Border>

            <!-- Scan Button -->
            <Border StrokeShape="RoundRectangle 10" HorizontalOptions="Fill">
                <sf:SfButton Text="&#xf085;  Scan for Printers"
                             FontFamily="FontAwesome"
                             FontSize="16" FontAttributes="Bold"
                             TextColor="#ffffff"
                             BackgroundColor="#1f6feb"
                             HeightRequest="50"
                             Clicked="OnScanClicked"/>
            </Border>

            <!-- Save Button -->
            <Border StrokeShape="RoundRectangle 10" HorizontalOptions="Fill">
                <sf:SfButton Text="&#xf00c;  Save Printer"
                             FontFamily="FontAwesome"
                             FontSize="16" FontAttributes="Bold"
                             TextColor="#ffffff"
                             BackgroundColor="#238636"
                             HeightRequest="50"
                             Clicked="OnSaveClicked"/>
            </Border>

            <!-- Back Button -->
            <Border StrokeShape="RoundRectangle 10" HorizontalOptions="Fill">
                <sf:SfButton Text="&#xf053;  Back"
                             FontFamily="FontAwesome"
                             FontSize="15"
                             TextColor="#8b949e"
                             BackgroundColor="#161b22"
                             HeightRequest="45"
                             Clicked="OnBackClicked"/>
            </Border>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
